{
  "name": "@aftergraph/brand",
  "version": "1.1.0",
  "description": "Canonical Brand OS, visual assets, semantic symbols, and UI contracts for Aftergraph",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-icons.mjs && node scripts/generate-families.mjs",
    "export-assets": "node scripts/export-assets.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "check": "npm run generate && npm run validate && npm test"
  },
  "bin": { "assetgen": "./scripts/assetgen.mjs" },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./tokens": {
      "types": "./types.d.ts",
      "import": "./index.mjs"
    },
    "./tokens.json": "./tokens.json",
    "./manifest.json": "./manifest.json",
    "./tokens.css": "./tokens.css",
    "./css": "./tokens.css",
    "./react": {
      "types": "./types.d.ts",
      "import": "./react.mjs"
    },
    "./svg/*": "./svg/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aftergraph/brand.git"
  },
  "keywords": [
    "aftergraph",
    "design-system",
    "brand",
    "tokens",
    "governed-intelligence",
    "visual-language"
  ],
  "author": "Aftergraph Architecture Council",
  "license": "Apache-2.0",
  "files": [
    "index.mjs",
    "react.mjs",
    "types.d.ts",
    "tokens.css",
    "tokens.json",
    "manifest.json",
    "USAGE-RULES.md",
    "DESIGN-SYSTEM.md",
    "svg", "identity", "semantics", "social", "editorial", "product", "wallpaper",
    "schemas", "scripts", "registry.json", "BRAND-ARCHITECTURE.md",
    "NAMING-AND-LANGUAGE.md", "ACCESSIBILITY.md", "MOTION.md",
    "SCREENSHOT-STANDARD.md", "RESEARCH-VISUAL-STANDARD.md", "PRESS-AND-MEDIA.md"
  ]
}
