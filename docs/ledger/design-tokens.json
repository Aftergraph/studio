{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Ledger Billing Design System \u2014 W3C DTCG Format",
  "ledger": {
    "color": {
      "accent": {
        "$value": "#0c52ef",
        "$type": "color",
        "$description": "Primary interactive / canonical state"
      },
      "accent-soft": {
        "$value": "#e8f0ff",
        "$type": "color"
      },
      "canvas": {
        "$value": "#f5f7fa",
        "$type": "color",
        "$description": "Page background (light)"
      },
      "canvas-dark": {
        "$value": "#080c14",
        "$type": "color",
        "$description": "Page background (dark)"
      },
      "surface": {
        "$value": "#ffffff",
        "$type": "color"
      },
      "surface-dark": {
        "$value": "#0e1630",
        "$type": "color"
      },
      "surface-strong": {
        "$value": "#f0f2f5",
        "$type": "color"
      },
      "surface-strong-dark": {
        "$value": "#1a2340",
        "$type": "color"
      },
      "text-primary": {
        "$value": "#0e1630",
        "$type": "color"
      },
      "text-primary-dark": {
        "$value": "#dce8f6",
        "$type": "color"
      },
      "text-muted": {
        "$value": "#4f5868",
        "$type": "color"
      },
      "text-muted-dark": {
        "$value": "#8993a4",
        "$type": "color"
      },
      "text-subtle": {
        "$value": "#8993a4",
        "$type": "color"
      },
      "border": {
        "$value": "#e2e6ec",
        "$type": "color"
      },
      "border-strong": {
        "$value": "#c8cdd6",
        "$type": "color"
      },
      "border-dark": {
        "$value": "#1e2a45",
        "$type": "color"
      },
      "success": {
        "$value": "#087b49",
        "$type": "color"
      },
      "warning": {
        "$value": "#8a5700",
        "$type": "color"
      },
      "danger": {
        "$value": "#b52d3c",
        "$type": "color"
      },
      "glass-bg": {
        "$value": "rgba(255,255,255,0.85)",
        "$type": "color"
      },
      "glass-bg-dark": {
        "$value": "rgba(14,22,48,0.85)",
        "$type": "color"
      }
    },
    "typography": {
      "font-sans": {
        "$value": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "$type": "fontFamily"
      },
      "font-mono": {
        "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "$type": "fontFamily"
      },
      "display": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "34px",
          "fontWeight": 760,
          "lineHeight": 1.02,
          "letterSpacing": "-0.045em"
        },
        "$type": "typography"
      },
      "headline": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "28px",
          "fontWeight": 740,
          "lineHeight": 1.1,
          "letterSpacing": "-0.03em"
        },
        "$type": "typography"
      },
      "title": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "22px",
          "fontWeight": 730,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        },
        "$type": "typography"
      },
      "subhead": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "18px",
          "fontWeight": 720,
          "lineHeight": 1.3,
          "letterSpacing": "-0.01em"
        },
        "$type": "typography"
      },
      "body-lg": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.55
        },
        "$type": "typography"
      },
      "body": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": 1.5
        },
        "$type": "typography"
      },
      "body-sm": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "13px",
          "fontWeight": 400,
          "lineHeight": 1.45
        },
        "$type": "typography"
      },
      "ui": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "12px",
          "fontWeight": 680,
          "lineHeight": 1.4,
          "letterSpacing": "0.04em"
        },
        "$type": "typography"
      },
      "caption": {
        "$value": {
          "fontFamily": "{ledger.typography.font-sans}",
          "fontSize": "11px",
          "fontWeight": 650,
          "lineHeight": 1.4,
          "letterSpacing": "0.05em"
        },
        "$type": "typography"
      },
      "tabular": {
        "$value": {
          "fontFeatureSettings": "'tnum'",
          "fontVariantNumeric": "tabular-nums"
        },
        "$type": "typography",
        "$description": "Applied to monetary values and counts"
      }
    },
    "spacing": {
      "xxs": {
        "$value": "2px",
        "$type": "dimension"
      },
      "xs": {
        "$value": "4px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "8px",
        "$type": "dimension"
      },
      "md": {
        "$value": "16px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "24px",
        "$type": "dimension"
      },
      "xl": {
        "$value": "32px",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "48px",
        "$type": "dimension"
      },
      "3xl": {
        "$value": "64px",
        "$type": "dimension"
      },
      "4xl": {
        "$value": "96px",
        "$type": "dimension"
      },
      "5xl": {
        "$value": "128px",
        "$type": "dimension"
      }
    },
    "radius": {
      "button": {
        "$value": "10px",
        "$type": "dimension"
      },
      "card": {
        "$value": "12px",
        "$type": "dimension"
      },
      "pill": {
        "$value": "9999px",
        "$type": "dimension"
      }
    },
    "shadow": {
      "soft": {
        "$value": "0 4px 24px rgba(8,12,20,0.04), 0 1px 2px rgba(8,12,20,0.03)",
        "$type": "shadow"
      },
      "float": {
        "$value": "0 22px 70px rgba(8,12,20,0.10), 0 2px 10px rgba(8,12,20,0.05), 0 0 0 1px rgba(8,12,20,0.03)",
        "$type": "shadow"
      },
      "glow": {
        "$value": "0 0 20px color-mix(in srgb, var(--accent) 15%, transparent)",
        "$type": "shadow"
      }
    },
    "motion": {
      "duration-fast": {
        "$value": "150ms",
        "$type": "duration"
      },
      "duration-normal": {
        "$value": "200ms",
        "$type": "duration"
      },
      "duration-slow": {
        "$value": "300ms",
        "$type": "duration"
      },
      "ease-default": {
        "$value": "ease",
        "$type": "cubicBezier"
      },
      "ease-spring": {
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "$type": "cubicBezier"
      },
      "reduced-motion": {
        "$value": "all transitions and animations disabled via prefers-reduced-motion media query",
        "$type": "other"
      }
    },
    "touch": {
      "target-min": {
        "$value": "44px",
        "$type": "dimension",
        "$description": "WCAG 2.5.5 minimum touch target"
      },
      "input-min": {
        "$value": "48px",
        "$type": "dimension",
        "$description": "Input height for mobile zoom prevention"
      }
    }
  }
}
